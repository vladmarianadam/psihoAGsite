# Singura sursă a adresei API (plan §9.3). În dev se lasă gol => se folosește
# proxy-ul Vite din vite.config.ts, deci apelurile pleacă relativ către /api.
VITE_API_BASE_URL=

# Ținta proxy-ului Vite în dev — trebuie să coincidă cu launchSettings.json.
VITE_DEV_API_TARGET=http://localhost:5180

# Date de contact afișate în UI (fără hardcodare în componente).
VITE_PHONE=+40 700 000 000
VITE_WHATSAPP=40700000000
VITE_EMAIL=contact@adinagghita.ro
VITE_SITE_URL=https://www.adinagghita.ro
